<Window x:Class="AiGameSave.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AiGameSave - 云电脑存档助手" Height="760" Width="1180"
        MinHeight="640" MinWidth="980" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="批量本地扫描" Click="BatchScan_Click" />
                <TextBlock Text="持久仓库" VerticalAlignment="Center" />
                <TextBox x:Name="RepositoryPathText" Width="330" />
                <Button Content="应用仓库" Click="ApplyRepository_Click" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="AiGameSave" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="找到存档，确认一次，之后一键继续游戏" Foreground="#666" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" BorderBrush="#D9DEE7" BorderThickness="1" Padding="12" CornerRadius="6" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏名称" VerticalAlignment="Center" />
                <TextBox x:Name="GameNameText" Grid.Row="0" Grid.Column="1" Text="" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="游戏 EXE" VerticalAlignment="Center" />
                <DockPanel Grid.Row="0" Grid.Column="3">
                    <Button DockPanel.Dock="Right" Content="选择" Click="ChooseExe_Click" />
                    <TextBox x:Name="ExecutableText" />
                </DockPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="模型 Base URL" VerticalAlignment="Center" />
                <TextBox x:Name="BaseUrlText" Grid.Row="1" Grid.Column="1" Text="https://api.deepseek.com/v1" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="模型" VerticalAlignment="Center" />
                <TextBox x:Name="ModelText" Grid.Row="1" Grid.Column="3" Text="deepseek-chat" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="API Key" VerticalAlignment="Center" />
                <PasswordBox x:Name="ApiKeyText" Grid.Row="2" Grid.Column="1" Margin="4" Padding="6" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="主密码（可选）" VerticalAlignment="Center" />
                <DockPanel Grid.Row="2" Grid.Column="3">
                    <Button DockPanel.Dock="Right" Content="解锁" Click="UnlockVault_Click" />
                    <PasswordBox x:Name="MasterPasswordText" Padding="6" />
                </DockPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="存档位置检测" Margin="0,0,10,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button Content="查找存档" Click="Research_Click" />
                        <Button Content="开始行为检测" Click="BeginBehavior_Click" />
                        <Button Content="我已保存" Click="CompleteBehavior_Click" />
                        <Button Content="确认选中位置" Click="ConfirmCandidate_Click" />
                    </WrapPanel>
                    <ListBox x:Name="CandidatesList" Grid.Row="1" DisplayMemberPath="Display" Margin="4" />
                    <TextBlock x:Name="CandidateDetails" Grid.Row="2" TextWrapping="Wrap" Foreground="#555" Margin="4" />
                </Grid>
            </GroupBox>
            <GroupBox Grid.Column="1" Header="已保护的游戏" >
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="GamesList" Grid.Row="0" DisplayMemberPath="Name" SelectionChanged="GamesList_SelectionChanged" Margin="4" />
                    <TextBox x:Name="GameStatus" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="4" />
                    <WrapPanel Grid.Row="2">
                        <Button Content="还原并启动" Click="RestoreLaunch_Click" />
                        <Button Content="直接启动" Click="Launch_Click" />
                        <Button Content="一键备份" Click="Backup_Click" />
                        <Button Content="打开存档目录" Click="OpenSaveDirectory_Click" />
                        <Button Content="历史版本" Click="History_Click" />
                    </WrapPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="3" Margin="0,12,0,0">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="就绪。" /></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
